{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wysh.ai/contracts/clinical-review-persistence-v1.schema.json",
  "title": "wysh.AI Persisted Clinical Review v1",
  "description": "Synthetic-only API contract for authenticated clinician review decisions. This is not clinical authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "tenant_id", "patient_id", "assessment_id", "assessment_input_hash", "state", "version", "events"],
  "properties": {
    "review_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "pattern": "^synthetic-.+"},
    "patient_id": {"type": "string", "pattern": "^synthetic-.+"},
    "disease_id": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_input_hash": {"type": "string", "minLength": 16},
    "state": {"enum": ["DRAFT", "APPROVED", "REJECTED", "REVISION_REQUESTED"]},
    "version": {"type": "integer", "minimum": 1},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "version", "action", "actor_subject", "actor_role", "occurred_at"], "properties": {"event_id": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 1}, "action": {"enum": ["created", "approve", "reject", "request_revision"]}, "actor_subject": {"type": "string", "minLength": 1}, "actor_role": {"const": "clinician"}, "note": {"type": ["string", "null"], "maxLength": 2000}, "occurred_at": {"type": "string", "format": "date-time"}}}}
  }
}
