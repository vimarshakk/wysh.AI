{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wysh.ai/contracts/clinical-snapshot-v1.schema.json",
  "title": "wysh.AI Clinical Snapshot v1",
  "description": "Synthetic, reviewable clinical context. This contract is not an authorization to use live patient data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "patient_id", "synthetic", "facts"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "patient_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "synthetic": {"const": true},
    "facts": {
      "type": "array", "maxItems": 100,
      "items": {"$ref": "#/$defs/clinicalFact"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_type", "recorded_at"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["observation", "condition", "medication", "encounter", "document"]},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    },
    "clinicalFact": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
