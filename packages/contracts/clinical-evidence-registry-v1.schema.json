{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wysh.ai/contracts/clinical-evidence-registry-v1.schema.json",
  "title": "wysh.AI Clinical Evidence Registry v1",
  "description": "Source metadata only. Registry entries do not authorize automatic execution of clinical content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "clinical-evidence-registry-v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "disease_id", "publisher", "title", "version", "source_url", "license_status", "applicable_population", "jurisdiction", "required_observations", "limitations", "approval_status", "clinical_reviewer", "review_expires_at", "content_copied"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "disease_id": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "publication_date": {"type": ["string", "null"]},
          "review_date": {"type": ["string", "null"]},
          "source_url": {"type": "string", "format": "uri"},
          "license_status": {"type": "string", "minLength": 1},
          "applicable_population": {"type": "string", "minLength": 1},
          "clinical_setting": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": "string", "minLength": 1},
          "required_observations": {"type": "array", "items": {"type": "string"}},
          "terminology": {"type": "array", "items": {"type": "string"}},
          "contraindications_exclusions": {"type": "array", "items": {"type": "string"}},
          "evidence_quality": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "approval_status": {"enum": ["UNREVIEWED", "ENGINEERING_ONLY", "CLINICALLY_REVIEWED"]},
          "clinical_reviewer": {"type": ["string", "null"]},
          "review_expires_at": {"type": ["string", "null"]},
          "content_copied": {"const": false}
        }
      }
    }
  }
}
