# Explicit local configuration only. Do not copy the WyshCare .env wholesale.
WMI_ENV=development
WMI_INFERENCE_ENABLED=false
WMI_REQUIRE_GATEWAY_AUTH=false
MODEL_ROUTING_ORDER=medgemma,openai-compatible,gemini
ALLOW_CLOUD_FALLBACK=false
# Empty means no model can be invoked through the gateway. Explicitly list approved IDs.
MODEL_ENABLED_IDS=
SERVICE_TOKEN_SECRET=
SERVICE_TOKEN_ISSUER=wyshcare
SERVICE_TOKEN_AUDIENCE=wysh-ai
# Use RS256 with SERVICE_TOKEN_JWKS_URL outside isolated local testing.
SERVICE_TOKEN_ALGORITHM=HS256
SERVICE_TOKEN_JWKS_URL=
SERVICE_TOKEN_JWKS_CACHE_TTL_SECONDS=300

# Gemini: server-side only; never expose in a frontend bundle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# MedGemma through an Ollama-compatible server.
# Example: Ollama http://127.0.0.1:11434 (run the model locally first).
MEDGEMMA_BASE_URL=http://127.0.0.1:11434
MEDGEMMA_MODEL=medgemma:4b
MEDGEMMA_MODEL_VERSION=

# vLLM, llama.cpp, or another OpenAI-compatible self-hosted endpoint.
# Examples: vLLM http://127.0.0.1:8000, llama.cpp http://127.0.0.1:8080.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_PATH=/v1/chat/completions

# TRION service-to-service boundary. Disabled until a verified endpoint exists.
TRION_ENABLED=false
TRION_BASE_URL=
TRION_API_KEY=
TRION_MODEL=
TRION_PATH=/v1/clinical/fhir-draft
TRION_TIMEOUT_MS=5000

PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=2
